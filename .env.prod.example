# docker-compose.prod.yml shu fayldagi o'zgaruvchilarni o'qiydi (compose
# fayl bilan bir joyda `.env` nomida bo'lishi kerak — git'ga kirmaydi).
# Backend/worker'ning o'z sozlamalari `backend/.env`da (backend/.env.example
# ga qarang), bu yerdagilar faqat compose darajasidagi infratuzilma uchun.

POSTGRES_USER=ariza
POSTGRES_PASSWORD=change-me-random-32-chars
POSTGRES_DB=ariza

MINIO_ROOT_USER=ariza
MINIO_ROOT_PASSWORD=change-me-random-32-chars

# Build vaqtida frontend bundle'iga ko'miladi (client-side kod shu manzilga
# so'rov yuboradi) — domen bilan bir xil bo'lishi kerak, nginx /api'ni shu
# domendan proxy qiladi.
NEXT_PUBLIC_API_URL=https://ariza.xron.uz
