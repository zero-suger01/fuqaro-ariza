DATABASE_URL=postgresql+psycopg://ariza:ariza@localhost:5433/ariza
# Testlar uchun ALOHIDA baza (docs/11-devops.md §1.1). DATABASE_URL bilan
# bir xil bo'lsa test to'plami ishga tushmaydi — dev bazani tozalab
# yuborishning oldini olish uchun.
TEST_DATABASE_URL=postgresql+psycopg://ariza:ariza@localhost:5433/ariza_test
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

TICKET_PREFIX=UY

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ariza
S3_SECRET_KEY=ariza12345
S3_BUCKET=ariza-complaints
S3_PUBLIC_BASE_URL=http://localhost:9000/ariza-complaints

CORS_ORIGINS=["http://localhost:3000"]

# Optional SMTP for email notifications
SMTP_HOST=
SMTP_PORT=587

# AI (docs/07-ai-layer.md)
# LLM_PROVIDER=ollama (standart, lokal) | deepseek (API, vaqtincha almashtirish
# uchun — ikkalasi ham bir xil LlmAnalysis sxemasini qaytaradi).
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_LOW_CONFIDENCE=0.6
# R1 (LLM-always): generatsiya CPU serverda daqiqalar oladi — timeout
# saxiy bo'lishi SHART, aks holda har murojaat jimgina draft'siz qoladi.
# O'lchangan qiymatlar va model tavsiyasi: docs/07-ai-layer.md §4.
LLM_TIMEOUT_S=300
LLM_MAX_ATTEMPTS=2

# STT — B2.4 scope
STT_PROVIDER=whisper
STT_WHISPER_MODEL=medium
MOHIRAI_API_KEY=

# Notifications — B4 scope
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
TELEGRAM_BOT_TOKEN=
BOT_API_TOKEN=

PUBLIC_BASE_URL=http://localhost:3000

# Seed admin (v1.4) — IKKALASI berilmasa `python -m app.seed` admin
# yaratMAYDI. Yaratilgan hisobda birinchi kirishda parol almashtirish
# majburiy. Standart parol kodda saqlanmaydi ([04] §5, [11] §1.2).
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=
